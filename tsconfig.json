{
    "compileOnSave": true,
    "compilerOptions": {
        "alwaysStrict": true,
        "lib": ["ESNext"],
        "module": "CommonJS",
        "esModuleInterop": true,
        "noUnusedParameters": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "noUnusedLocals": true,
        "removeComments": false,
        "target": "ES2020",
        "strictNullChecks": true,
        "preserveConstEnums": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true
    },
    "include": [
        "index.ts",
        "api/**/*.ts",
        "authentication/**/*.ts",
        "eventsub/**/*.ts",
    ],
    "exclude": ["node_modules"]
}